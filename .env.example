# Main cloud backend. These values are safe to expose in an Expo client because
# database access is protected by Supabase Auth and Row Level Security.
EXPO_PUBLIC_DATA_BACKEND=supabase
EXPO_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Optional local Node backend fallback for development.
# EXPO_PUBLIC_DATA_BACKEND=local
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000
# Gemini AI Stylist — dapatkan API key gratis di https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=AIza_YOUR_KEY_HERE
