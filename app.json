{
  "expo": {
    "name": "CIRCULAI",
    "slug": "circulai",
    "version": "1.0.0",
    "scheme": "circulai",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/logo_app.png",
    "splash": {
      "image": "./assets/images/logo_app.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFBF6"
    },
    "android": {
      "package": "com.circulai.app",
      "edgeToEdgeEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo_app.png",
        "backgroundColor": "#FAFBF6"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.circulai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Izinkan CIRCULAI mengakses kamera untuk memindai QR tag Digital Product Passport pakaian.",
        "NSPhotoLibraryUsageDescription": "Izinkan CIRCULAI mengakses galeri untuk memilih foto profil atau referensi desain."
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#FAF7F0",
      "barStyle": "dark-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#FAF7F0",
      "barStyle": "dark-content",
      "enforceContrast": false
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ff3bd376-8459-4608-a525-c5c285c995ee",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "ff3bd376-8459-4608-a525-c5c285c995ee"
      }
    },
    "owner": "arwnsyh",
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan CIRCULAI mengakses kamera untuk memindai QR tag Digital Product Passport pakaian.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan CIRCULAI mengakses galeri untuk memilih foto profil atau referensi desain.",
          "cameraPermission": "Izinkan CIRCULAI mengakses kamera untuk mengambil foto referensi desain ke penjahit.",
          "microphonePermission": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#FAF7F0",
          "barStyle": "dark",
          "borderColor": "#E9E7E1",
          "position": "relative",
          "visibility": "visible"
        }
      ]
    ]
  }
}
