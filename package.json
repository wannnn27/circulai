{
  "name": "circulai",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go --lan --clear",
    "start:tunnel": "expo start --go --tunnel --clear",
    "server": "node server/index.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "expo lint",
    "update:preview": "npx eas-cli update --channel preview --environment preview",
    "update:production": "npx eas-cli update --channel production --environment production",
    "supabase:push": "npx supabase db push",
    "supabase:functions": "npx supabase functions deploy create-midtrans-snap && npx supabase functions deploy midtrans-webhook --no-verify-jwt"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.108.0",
    "expo": "~54.0.36",
    "expo-camera": "~17.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-navigation-bar": "~5.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.9",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "glob": "7.2.3",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0"
  }
}
